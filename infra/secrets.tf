# ------------------------------------------------------------------------------
# Application secrets (Secrets Manager)
#
# One JSON secret per environment. ECS pulls individual keys out by name (see
# ecs.tf task_secrets). JWT key is generated here; DB credentials are read back
# from the RDS-managed master secret; integration credentials come from
# gitignored tfvars (empty until the phase that needs them).
# ------------------------------------------------------------------------------

resource "random_password" "jwt_key" {
  length  = 64
  special = true
}

resource "aws_secretsmanager_secret" "app" {
  name        = "dalista/${var.environment}"
  description = "Dalista ${var.environment} application secrets"

  tags = { Name = "dalista-${var.environment}-app-secrets" }
}

# RDS-managed master password, auto-generated by the aws_db_instance.
data "aws_secretsmanager_secret_version" "rds_master" {
  secret_id = aws_db_instance.main.master_user_secret[0].secret_arn
}

locals {
  rds_master_password            = jsondecode(data.aws_secretsmanager_secret_version.rds_master.secret_string)["password"]
  rds_master_password_urlencoded = urlencode(local.rds_master_password)
  db_name                        = "dalista_${var.environment}"
}

resource "aws_secretsmanager_secret_version" "app" {
  secret_id = aws_secretsmanager_secret.app.id

  secret_string = jsonencode({
    JWT_KEY     = random_password.jwt_key.result
    DB_HOST     = aws_db_instance.main.address
    DB_PORT     = "5432"
    DB_USER     = aws_db_instance.main.username
    DB_PASSWORD = local.rds_master_password
    DB_NAME     = local.db_name
    SENTRY_DSN  = var.sentry_dsn

    # Integrations — blank until the phase that wires each one.
    SMS_MISR_USERNAME            = var.sms_misr_username
    SMS_MISR_PASSWORD            = var.sms_misr_password
    SMS_MISR_SENDER              = var.sms_misr_sender
    FCM_CREDENTIALS_JSON         = var.fcm_credentials_json
    APPLE_IAP_PRIVATE_KEY        = var.apple_iap_private_key
    GOOGLE_PLAY_CREDENTIALS_JSON = var.google_play_credentials_json

    # Goose connection string for the migrate task (sslmode=require against RDS).
    GOOSE_DBSTRING = "postgres://${aws_db_instance.main.username}:${local.rds_master_password_urlencoded}@${aws_db_instance.main.address}:5432/${local.db_name}?sslmode=require"
  })
}
