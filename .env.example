# Dalista API — local development environment.
# Copy to .env and fill in. Existing process env vars take precedence over .env.

# --- Core ---
APP_ENV=development
SENTRY_DSN=
FRONT_END_URL=http://localhost:3000
CORS_ALLOW_ALL=false
RATE_LIMIT_PER_MINUTE=40

# --- Auth / JWT ---
JWT_KEY=dev-jwt-secret-change-me-minimum-32-characters!!
JWT_EXPIRY_HOURS=8

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dalista
DB_SSLMODE=disable

# --- Cache (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Goose (migrations) ---
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://postgres:postgres@localhost:5432/dalista?sslmode=disable
GOOSE_MIGRATION_DIR=./app/repository/migrations

# --- Integrations (later phases; leave blank for Phase 0) ---
# SMS Misr (OTP + admin SMS)
SMS_MISR_USERNAME=
SMS_MISR_PASSWORD=
SMS_MISR_SENDER=
# Firebase Cloud Messaging
FCM_CREDENTIALS_JSON=
# Apple App Store Server API
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_BUNDLE_ID=
# Google Play Developer API
GOOGLE_PLAY_CREDENTIALS_JSON=
GOOGLE_PLAY_PACKAGE_NAME=
# OAuth (Google + Facebook)
GOOGLE_OAUTH_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
